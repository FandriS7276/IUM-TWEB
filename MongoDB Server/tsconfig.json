{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "lib": ["ES2022"],
        "outDir": "./dist",
        "rootDir": "./",
        "strict": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "moduleResolution": "node",
        "declaration": true,
        "sourceMap": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false
    },
    "include": [
        "app.ts",
        "types/**/*.ts",
        "config/**/*.ts",
        "database/**/*.ts",
        "schema/**/*.ts",
        "utils/**/*.ts",
        "services/**/*.ts",
        "controller/**/*.ts",
        "routes/**/*.ts"
    ],
    "exclude": ["node_modules", "dist", "public", "bin"]
}