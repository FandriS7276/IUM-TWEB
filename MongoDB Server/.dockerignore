# ==============================================================================
# .dockerignore — MongoDB Server (Express + TypeScript Backend)
# ==============================================================================

# Dependencies — reinstalled inside the image
node_modules

# Compiled output — rebuilt inside the image by `npm run build`
dist

# Version control
.git
.gitignore
.gitattributes

# Environment files — NEVER bake secrets into an image
.env
.env.*
!.env.example

# Editor / OS artefacts
.DS_Store
Thumbs.db
.vscode
.idea
*.log

# Docker files themselves
Dockerfile
.dockerignore
