# This file contains environment variables for your Node.js application.
# It should be named .env and placed in the root of your project.
# Make sure to add .env to your .gitignore file to avoid committing sensitive information to version control.

# Port your server listens on (optional – you already fallback to 3000)
PORT=3000

# MongoDB connection string – THIS IS THE MOST IMPORTANT ONE
# Replace with your real Atlas or local connection string
MONGODB_URI=mongodb+srv://andrefst03_db_user:testing1@cluster0.3rvremd.mongodb.net/?appName=Cluster0

# Environment mode (helps you show/hide detailed errors later)
NODE_ENV=development

# If you add user login later (very common next step)
JWT_SECRET=someSuperLongRandomStringNobodyShouldSee123abcXYZ

# If you use any external API (e.g. for movie posters, emails, etc.)
TMDB_API_KEY=your_tmdb_key_here
EMAIL_PASSWORD=your_app_password
# Add more later: JWT_SECRET=supersecretkey123 etc.